# Supabase project URL exposed to the application.
NEXT_PUBLIC_SUPABASE_URL=
# Supabase server-only service role key. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Development/demo user credentials used by the /dev tooling.
DEV_EMAIL=demo@example.com
DEV_PASSWORD=password
# Prefix applied to application-owned Supabase table names.
SUPABASE_TABLE_PREFIX=sm_

# OpenAI server-side API key used by the assistant.
OPENAI_API_KEY=

# Default model used by the AI assistant.
AI_ASSISTANT_DEFAULT_MODEL=o3-mini
# Model used for assistant product-search operations.
AI_ASSISTANT_SEARCH_MODEL=gpt-4o-mini
# Comma-separated model IDs allowed in the assistant model picker.
AI_ASSISTANT_ALLOWED_MODELS=o3-mini,gpt-4o-mini,gpt-4.1-mini

# Enable or disable client-side dictation.
NEXT_PUBLIC_AI_ASSISTANT_DICTATION_ENABLED=true
# Dictation provider; "browser" uses the browser's speech recognition support.
NEXT_PUBLIC_AI_ASSISTANT_DICTATION_PROVIDER=browser
# Automatically submit the transcript after dictation finishes.
NEXT_PUBLIC_AI_ASSISTANT_DICTATION_AUTO_SUBMIT=true
# Language/locale used by browser dictation.
NEXT_PUBLIC_AI_ASSISTANT_DICTATION_LANGUAGE=en-US
